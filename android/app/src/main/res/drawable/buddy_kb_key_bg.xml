<?xml version="1.0" encoding="utf-8"?>
<!-- A flat Gboard-style character key. Both states use theme resources so a future explicit
     light/dark preference can select a resource configuration without rebuilding the key views. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/buddy_kb_key_pressed" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/buddy_kb_background" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
