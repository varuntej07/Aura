<?xml version="1.0" encoding="utf-8"?>
<!-- A function-key pill using the active theme's special-key surface. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/buddy_kb_key_pressed" />
            <corners android:radius="27dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/buddy_kb_key_special" />
            <corners android:radius="27dp" />
        </shape>
    </item>
</selector>
